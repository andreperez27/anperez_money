# ==========================================================================
# Modelo de configuração — este arquivo É seguro de subir pro GitHub
# ==========================================================================
# Ele não tem nenhum valor real, só mostra quais variáveis o projeto espera
# encontrar. Quando você (ou qualquer pessoa que clone o repositório no
# futuro) for rodar o projeto, o processo é: copiar este arquivo com o nome
# ".env.local" e preencher com os valores reais, pegos em
# Project Settings → API dentro do seu projeto Supabase.
#
#   cp .env.example .env.local
#
# O Vite exige o prefixo VITE_ em qualquer variável que precise estar
# disponível no código do navegador. Sem esse prefixo, a variável fica
# invisível pro front-end, mesmo que esteja definida no arquivo.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Lembrete: a anon key é pública por natureza (fica embutida no código que
# roda no navegador de qualquer visitante). Quem protege seus dados é a
# política de RLS que já está ativa no banco, não o sigilo dessa chave.
# A chave que JAMAIS deve aparecer aqui, neste projeto ou em qualquer
# arquivo versionado, é a "service_role key".
